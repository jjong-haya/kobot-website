#!/bin/sh
# Pre-commit hook to prevent committing sensitive files

echo "🔍 Checking for sensitive files..."

# Check if .env file is being committed
if git diff --cached --name-only | grep -q "^\.env$"; then
    echo "❌ ERROR: .env file detected in commit!"
    echo "⚠️  This file contains sensitive API keys and should NOT be committed."
    echo ""
    echo "To fix this:"
    echo "  git reset HEAD .env"
    echo ""
    exit 1
fi

# Check for any .env files
if git diff --cached --name-only | grep -q "\.env"; then
    echo "⚠️  WARNING: Potential .env file detected!"
    echo "Files found:"
    git diff --cached --name-only | grep "\.env"
    echo ""
    read -p "Are you sure you want to commit these? (y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        exit 1
    fi
fi

# Check for common secret patterns in staged files
if git diff --cached | grep -iE "(api_key|api_secret|password|access_token|secret_key|private_key).*=.*['\"][^'\"]+['\"]"; then
    echo "⚠️  WARNING: Potential secret detected in code!"
    echo ""
    echo "Found patterns that look like API keys or passwords."
    echo "Please review your code before committing."
    echo ""
    read -p "Continue anyway? (y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        exit 1
    fi
fi

echo "✅ Security check passed!"
exit 0
